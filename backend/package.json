{
	"name": "sloty",
	"version": "1.0.0",
	"description": "An online scheduling and booking platform designed to simplify appointment management for any business.",
	"main": "index.js",
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"dev": "tsx watch src/server.ts",
		"build": "prisma generate && tsc",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"postinstall": "prisma generate"
	},
	"keywords": [],
	"author": "Kevin Marquez",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.10.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.3",
		"@types/pg": "^8.23.1",
		"prisma": "7.10.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"cors": "^2.8.6",
		"dotenv": "^18.0.4",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"pg": "^8.23.0",
		"zod": "^4.6.5"
	}
}
